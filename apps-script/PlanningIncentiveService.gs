function monday_(date){var value=new Date(date||new Date());var day=value.getUTCDay();value.setUTCDate(value.getUTCDate()-(day===0?6:day-1));return value.toISOString().slice(0,10);}
function weekBusinessMonth_(weekStart){var thursday=new Date(dateOnly_(weekStart)+'T00:00:00Z');thursday.setUTCDate(thursday.getUTCDate()+3);return thursday.toISOString().slice(0,7);}

function targetForDate_(targets,source,tenurity,date){return targets.filter(function(item){return String(item.source).toLowerCase()===String(source).toLowerCase()&&item.tenurity===tenurity&&String(item.effectiveFrom)<=date&&(!item.effectiveTo||String(item.effectiveTo)>=date);}).sort(function(a,b){return String(b.effectiveFrom).localeCompare(String(a.effectiveFrom));})[0]||null;}

function generatePlanningSnapshot_(context,payload){var kind=String(payload.kind||'');if(['weekly','monthly'].indexOf(kind)<0)throw apiError_(400,'Planning kind must be weekly or monthly.');return withWriteLock_(function(){var stamp=now_();if(kind==='weekly'){var period=monday_(new Date());var month=weekBusinessMonth_(period);var snapshots=new SheetRepository_('weeklySnapshots');if(snapshots.find(function(row){return dateOnly_(row.weekStart)===period;}).length)throw apiError_(409,'The current weekly snapshot is already frozen.');var monthly=listMonthlyMappings_({month:month}).filter(function(row){return String(row.status).toUpperCase()==='ACTIVE'&&parseSelectedWeeks_(row.selectedWeeks,month).indexOf(period)>=0;});var mappings=monthly.map(function(row){return{id:id_(),weekStart:period,executiveId:row.executiveId,employeeId:row.employeeId,name:row.name,manager:row.manager,source:row.source,tenurity:normalizeTenurity_(row.tenurity),status:row.status,frozenAt:stamp,createdAt:stamp};});var targetVersions=listTargets_();var weeklyTargets=mappings.map(function(mapping){var target=targetForDate_(targetVersions,mapping.source,mapping.tenurity,period);return{id:id_(),weekStart:period,executiveId:mapping.executiveId,source:mapping.source,tenurity:mapping.tenurity,targetVersion:target?target.version:'',revenue:Number(target&&target.revenue)||0,login:Number(target&&target.login)||0,demo:Number(target&&target.demo)||0,license:Number(target&&target.license)||0,proPlatform:Number(target&&target.proPlatform)||0,arpl:Number(target&&target.arpl)||0,createdAt:stamp};});new SheetRepository_('weeklyMappings').insertMany(mappings);new SheetRepository_('weeklyTargets').insertMany(weeklyTargets);snapshots.insertMany([{id:id_(),weekStart:period,status:'FROZEN',rowCount:mappings.length,createdAt:stamp,createdBy:context.email}]);audit_(context,'weeklySnapshots','Planning','CREATE',period,null,{businessMonth:month,rowCount:mappings.length,targetRows:weeklyTargets.length},'Immutable weekly mapping and target snapshot using Thursday business month',1);return{period:period,businessMonth:month,executives:mappings.length,targets:weeklyTargets.length};}var currentMonth=monthOnly_(now_().slice(0,7));var monthlySnapshots=new SheetRepository_('monthlySnapshots');if(monthlySnapshots.find(function(row){return monthOnly_(row.month)===currentMonth;}).length)throw apiError_(409,'The current monthly snapshot is already frozen.');var mapped=listMonthlyMappings_({month:currentMonth});monthlySnapshots.insertMany([{id:id_(),month:currentMonth,status:'FROZEN',rowCount:mapped.length,createdAt:stamp,createdBy:context.email}]);audit_(context,'monthlySnapshots','Planning','CREATE',currentMonth,null,{rowCount:mapped.length},'Immutable monthly snapshot',1);return{period:currentMonth,executives:mapped.length};});}

function weeklyIncentiveRepository_(){var spreadsheet=SpreadsheetApp.openById(requiredProperty_('SPREADSHEET_ID'));if(!spreadsheet.getSheetByName('weeklyIncentives')){var lock=LockService.getScriptLock();lock.waitLock(30000);try{if(!spreadsheet.getSheetByName('weeklyIncentives'))ensureSheet_(spreadsheet,'weeklyIncentives',PLATFORM.SHEETS.weeklyIncentives);}finally{lock.releaseLock();}}return new SheetRepository_('weeklyIncentives');}
function monthWeekStarts_(month){if(!/^\d{4}-\d{2}$/.test(month))throw apiError_(400,'Month must be YYYY-MM.');var date=new Date(month+'-01T00:00:00Z');var day=date.getUTCDay();date.setUTCDate(date.getUTCDate()-(day===0?6:day-1));var result=[];for(var index=0;index<6;index++){var weekStart=date.toISOString().slice(0,10);if(weekBusinessMonth_(weekStart)===month)result.push(weekStart);date.setUTCDate(date.getUTCDate()+7);}return result;}
function incentiveAmounts_(target,revenue){var achievement=target?revenue/target:0;var rate=achievement>=1.2?0.04:achievement>=1?0.025:0;var bonus=Math.max(revenue-target,0)*rate;return{achievement:achievement,bonus:bonus,incentive:revenue*rate+bonus};}

function nullableNumber_(value){return value===''||value===null||value===undefined?null:Number(value);}
function listIncentives_(payload){var month=monthOnly_(payload.month||now_().slice(0,7));var monthly=new SheetRepository_('incentives').find(function(row){return monthOnly_(row.month)===month;});var latestVersion=monthly.reduce(function(max,row){return Math.max(max,Number(row.calculationVersion)||0);},0);var monthlyLatest=monthly.filter(function(row){return Number(row.calculationVersion)===latestVersion;});var weekly=weeklyIncentiveRepository_().find(function(row){return monthOnly_(row.month)===month&&Number(row.calculationVersion)===latestVersion;});var weeks=monthWeekStarts_(month);var byExecutive={};weekly.forEach(function(row){if(!byExecutive[row.executiveId])byExecutive[row.executiveId]={};byExecutive[row.executiveId][dateOnly_(row.weekStart)]={target:nullableNumber_(row.target),eligibleRevenue:nullableNumber_(row.eligibleRevenue),achievement:nullableNumber_(row.achievement),bonus:nullableNumber_(row.bonus),incentive:nullableNumber_(row.incentive)};});var rows=monthlyLatest.map(function(row){return{id:row.id,executiveId:row.executiveId,executiveName:row.executiveName,manager:row.manager,weeks:byExecutive[row.executiveId]||{},monthTotal:{target:Number(row.target)||0,revenue:Number(row.eligibleRevenue)||0,achievement:Number(row.achievement)||0,bonus:Number(row.bonus)||0,incentive:Number(row.incentive)||0},calculationVersion:Number(row.calculationVersion)||0};});return{month:month,weeks:weeks,rows:rows,calculationVersion:latestVersion};}

function calculateIncentives_(context,payload){var month=monthOnly_(payload.month||now_().slice(0,7));var weekStarts=monthWeekStarts_(month);weeklyIncentiveRepository_();return withWriteLock_(function(){var mappings=listMonthlyMappings_({month:month});var weeklyMappings=new SheetRepository_('weeklyMappings').find(function(row){return weekStarts.indexOf(dateOnly_(row.weekStart))>=0;});var targets=listTargets_();var frozenTargets=new SheetRepository_('weeklyTargets').find(function(row){return weekStarts.indexOf(dateOnly_(row.weekStart))>=0;});var performance=new SheetRepository_('performance').find(function(row){return String(row.periodType).toUpperCase()==='WEEK'&&weekStarts.indexOf(dateOnly_(row.period))>=0;});var oldMonthly=new SheetRepository_('incentives').find(function(row){return monthOnly_(row.month)===month;});var version=oldMonthly.reduce(function(max,row){return Math.max(max,Number(row.calculationVersion)||0);},0)+1;var stamp=now_();var weeklyRows=[];var monthlyRows=mappings.map(function(monthlyMapping){var totals={target:0,revenue:0,bonus:0,incentive:0};var selected=parseSelectedWeeks_(monthlyMapping.selectedWeeks,month);weekStarts.forEach(function(weekStart){if(selected.indexOf(weekStart)<0){weeklyRows.push({id:id_(),month:month,weekStart:weekStart,executiveId:monthlyMapping.executiveId,executiveName:monthlyMapping.name,manager:monthlyMapping.manager,target:'',eligibleRevenue:'',achievement:'',bonus:'',incentive:'',calculationVersion:version,createdAt:stamp,createdBy:context.email});return;}var mapping=weeklyMappings.find(function(item){return item.executiveId===monthlyMapping.executiveId&&dateOnly_(item.weekStart)===weekStart;})||monthlyMapping;var frozenTarget=frozenTargets.find(function(item){return item.executiveId===monthlyMapping.executiveId&&dateOnly_(item.weekStart)===weekStart;});var versionTarget=frozenTarget?null:targetForDate_(targets,mapping.source,mapping.tenurity,weekStart);var targetRevenue=Number(frozenTarget?frozenTarget.revenue:versionTarget&&versionTarget.revenue)||0;var actual=performance.find(function(item){return item.executiveId===monthlyMapping.executiveId&&dateOnly_(item.period)===weekStart;})||{};var revenue=Number(actual.revenue||0)+Number(actual.manualRevenue||0);var amounts=incentiveAmounts_(targetRevenue,revenue);weeklyRows.push({id:id_(),month:month,weekStart:weekStart,executiveId:monthlyMapping.executiveId,executiveName:monthlyMapping.name,manager:mapping.manager,target:targetRevenue,eligibleRevenue:revenue,achievement:amounts.achievement,bonus:amounts.bonus,incentive:amounts.incentive,calculationVersion:version,createdAt:stamp,createdBy:context.email});totals.target+=targetRevenue;totals.revenue+=revenue;totals.bonus+=amounts.bonus;totals.incentive+=amounts.incentive;});return{id:id_(),month:month,executiveId:monthlyMapping.executiveId,executiveName:monthlyMapping.name,manager:monthlyMapping.manager,target:totals.target,eligibleRevenue:totals.revenue,achievement:totals.target?totals.revenue/totals.target:0,bonus:totals.bonus,incentive:totals.incentive,calculationVersion:version,createdAt:stamp,createdBy:context.email};});weeklyIncentiveRepository_().insertMany(weeklyRows);new SheetRepository_('incentives').insertMany(monthlyRows);audit_(context,'incentives','Incentive','CALCULATE',month,{previousRows:oldMonthly.length},{monthlyRows:monthlyRows.length,weeklyRows:weeklyRows.length,weeks:weekStarts},'Weekly-pivot and monthly incentive calculation',version);return{month:month,calculationVersion:version,weeks:weekStarts,rows:monthlyRows};});}

function incentiveExportTable_(report){var blank=function(value){return value===null||value===undefined?'':value;};var headers=['Executive','Manager'];report.weeks.forEach(function(week,index){['Target','Revenue','Achievement','Bonus','Incentive'].forEach(function(metric){headers.push('Week '+(index+1)+' '+metric+' ('+week+')');});});headers=headers.concat(['Month Target','Month Revenue','Month Achievement','Month Bonus','Month Incentive','Version']);var rows=report.rows.map(function(row){var values=[row.executiveName,row.manager];report.weeks.forEach(function(week){var item=row.weeks[week]||{};values.push(blank(item.target),blank(item.eligibleRevenue),blank(item.achievement),blank(item.bonus),blank(item.incentive));});return values.concat([row.monthTotal.target,row.monthTotal.revenue,row.monthTotal.achievement,row.monthTotal.bonus,row.monthTotal.incentive,row.calculationVersion]);});return{headers:headers,rows:rows};}
function exportIncentivesToGoogleSheet_(context,payload){var report=listIncentives_(payload||{});if(!report.rows.length)throw apiError_(404,'Calculate incentives before exporting this month.');var table=incentiveExportTable_(report);var title='IB Incentives '+report.month+' v'+report.calculationVersion;var spreadsheet=SpreadsheetApp.create(title);var sheet=spreadsheet.getSheets()[0];sheet.setName('Incentives '+report.month);sheet.getRange(1,1,table.rows.length+1,table.headers.length).setValues([table.headers].concat(table.rows));sheet.setFrozenRows(1);sheet.getRange(1,1,1,table.headers.length).setFontWeight('bold').setBackground('#dbeafe').setWrap(true);sheet.autoResizeColumns(1,table.headers.length);sheet.getRange(2,3,table.rows.length,Math.max(1,table.headers.length-2)).setNumberFormat('#,##0.00');spreadsheet.addViewer(context.email);audit_(context,'incentives','Incentive','EXPORT',report.month,null,{spreadsheetId:spreadsheet.getId(),rowCount:table.rows.length},'Export incentive report to Google Sheet',report.calculationVersion);return{id:spreadsheet.getId(),url:spreadsheet.getUrl(),title:title,rowCount:table.rows.length};}

function dashboard_(payload){var month=monthOnly_(payload.month||now_().slice(0,7));var report=listIncentives_({month:month});var values=report.rows.map(function(row){return row.monthTotal;});var target=values.reduce(function(sum,row){return sum+Number(row.target||0);},0);var revenue=values.reduce(function(sum,row){return sum+Number(row.revenue||0);},0);var incentive=values.reduce(function(sum,row){return sum+Number(row.incentive||0);},0);return{activeExecutives:new SheetRepository_('executives').find(function(row){return row.active===true||String(row.active).toLowerCase()==='true';}).length,month:month,target:target,revenue:revenue,incentive:incentive,trend:[{month:month,target:target,revenue:revenue,incentive:incentive}]};}
