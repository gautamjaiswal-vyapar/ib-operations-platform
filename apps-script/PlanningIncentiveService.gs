function monday_(date){var value=new Date(date||new Date());var day=value.getUTCDay();value.setUTCDate(value.getUTCDate()-(day===0?6:day-1));return value.toISOString().slice(0,10);}
function generatePlanningSnapshot_(context,payload){var kind=String(payload.kind||'');if(['weekly','monthly'].indexOf(kind)<0)throw apiError_(400,'Planning kind must be weekly or monthly.');return withWriteLock_(function(){var stamp=now_();var executives=new SheetRepository_('executives').find(function(row){return row.active===true||String(row.active).toLowerCase()==='true';});if(kind==='weekly'){var period=monday_(new Date());var snapshots=new SheetRepository_('weeklySnapshots');if(snapshots.find(function(row){return row.weekStart===period;}).length)throw apiError_(409,'The current weekly snapshot is already frozen.');var mappings=executives.map(function(row){return{id:id_(),weekStart:period,executiveId:row.id,employeeId:row.employeeId,name:row.name,manager:row.manager,source:row.source,tenurity:calculateTenurity_(row.doj,period.slice(0,7)),status:row.status,frozenAt:stamp,createdAt:stamp};});new SheetRepository_('weeklyMappings').insertMany(mappings);snapshots.insertMany([{id:id_(),weekStart:period,status:'FROZEN',rowCount:mappings.length,createdAt:stamp,createdBy:context.email}]);audit_(context,'weeklySnapshots','Planning','CREATE',period,null,{rowCount:mappings.length},'Immutable weekly snapshot',1);return{period:period,executives:mappings.length};}var month=now_().slice(0,7);var monthlySnapshots=new SheetRepository_('monthlySnapshots');if(monthlySnapshots.find(function(row){return String(row.month).slice(0,7)===month;}).length)throw apiError_(409,'The current monthly snapshot is already frozen.');var mapped=new SheetRepository_('monthlyMappings').find(function(row){return String(row.month).slice(0,7)===month;});monthlySnapshots.insertMany([{id:id_(),month:month,status:'FROZEN',rowCount:mapped.length,createdAt:stamp,createdBy:context.email}]);audit_(context,'monthlySnapshots','Planning','CREATE',month,null,{rowCount:mapped.length},'Immutable monthly snapshot',1);return{period:month,executives:mapped.length};});}
function listIncentives_(payload){var month=String(payload.month||now_().slice(0,7));return new SheetRepository_('incentives').find(function(row){return String(row.month).slice(0,7)===month;});}
function calculateIncentives_(context,payload){var month=String(payload.month||now_().slice(0,7));return withWriteLock_(function(){var mappings=listMonthlyMappings_({month:month});var targets=listTargets_();var performance=new SheetRepository_('performance').find(function(row){return row.periodType==='MONTH'&&String(row.period).slice(0,7)===month;});var old=listIncentives_({month:month});var version=old.reduce(function(max,row){return Math.max(max,Number(row.calculationVersion)||0);},0)+1;var stamp=now_();var rows=mappings.map(function(mapping){var target=targets.filter(function(item){return item.source===mapping.source&&item.tenurity===mapping.tenurity&&String(item.effectiveFrom)<=month+'-31'&&(!item.effectiveTo||String(item.effectiveTo)>=month+'-01');}).sort(function(a,b){return String(b.effectiveFrom).localeCompare(String(a.effectiveFrom));})[0];var actual=performance.find(function(item){return item.executiveId===mapping.executiveId;})||{};var targetRevenue=Number(target&&target.revenue)||0;var revenue=Number(actual.revenue||0)+Number(actual.manualRevenue||0);var achievement=targetRevenue?revenue/targetRevenue:0;var rate=achievement>=1.2?0.04:achievement>=1?0.025:0;var bonus=Math.max(revenue-targetRevenue,0)*rate;return{id:id_(),month:month,executiveId:mapping.executiveId,executiveName:mapping.name,manager:mapping.manager,target:targetRevenue,eligibleRevenue:revenue,achievement:achievement,bonus:bonus,incentive:revenue*rate+bonus,calculationVersion:version,createdAt:stamp,createdBy:context.email};});new SheetRepository_('incentives').insertMany(rows);audit_(context,'incentives','Incentive','CALCULATE',month,{previousRows:old.length},{rowCount:rows.length},'Monthly incentive calculation',version);return{month:month,calculationVersion:version,rows:rows};});}
function dashboard_(payload){var month=String(payload.month||now_().slice(0,7));var rows=listIncentives_({month:month});var latest={};rows.forEach(function(row){if(!latest[row.executiveId]||Number(row.calculationVersion)>Number(latest[row.executiveId].calculationVersion))latest[row.executiveId]=row;});var values=Object.keys(latest).map(function(key){return latest[key];});var target=values.reduce(function(sum,row){return sum+Number(row.target||0);},0);var revenue=values.reduce(function(sum,row){return sum+Number(row.eligibleRevenue||0);},0);var incentive=values.reduce(function(sum,row){return sum+Number(row.incentive||0);},0);return{activeExecutives:new SheetRepository_('executives').find(function(row){return row.active===true||String(row.active).toLowerCase()==='true';}).length,month:month,target:target,revenue:revenue,incentive:incentive,trend:[{month:month,target:target,revenue:revenue,incentive:incentive}]};}
