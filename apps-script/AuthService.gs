function passwordHash_(password,salt){var value=String(salt)+'|'+String(password)+'|';for(var index=0;index<6000;index++)value=Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,value,Utilities.Charset.UTF_8));return value;}
function tokenHash_(token){return Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(token)+'|',Utilities.Charset.UTF_8));}
function secureToken_(){return Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,'');}
function validatePassword_(password){if(String(password||'').length<12)throw apiError_(400,'Password must contain at least 12 characters.');}
function setUserPassword_(email,password,requiredRole){validatePassword_(password);return withWriteLock_(function(){var repo=new SheetRepository_('users');var rows=repo.all();var normalized=normalizeEmail_(email);var index=rows.findIndex(function(row){return row.email===normalized;});if(index<0)throw new Error('User does not exist: '+normalized);if(requiredRole&&rows[index].role!==requiredRole)throw new Error('User does not have the required role.');var salt=secureToken_().slice(0,32);rows[index].passwordSalt=salt;rows[index].passwordHash=passwordHash_(password,salt);rows[index].status='ACTIVE';rows[index].failedAttempts=0;rows[index].lockedUntil='';rows[index].activationCodeHash='';rows[index].activationExpiresAt='';rows[index].updatedAt=now_();repo.replaceAll(rows);return{email:normalized,role:rows[index].role,status:'ACTIVE'};});}
function login_(payload){var email=normalizeEmail_(payload.email);var password=String(payload.password||'');var generic=apiError_(401,'Email or password is incorrect.');return withWriteLock_(function(){var repo=new SheetRepository_('users');var rows=repo.all();var index=rows.findIndex(function(row){return row.email===email;});if(index<0)throw generic;var user=rows[index];if(user.status!=='ACTIVE'||!user.passwordHash)throw generic;if(user.lockedUntil&&new Date(user.lockedUntil).getTime()>Date.now())throw apiError_(429,'Account is temporarily locked. Try again later.');if(passwordHash_(password,user.passwordSalt)!==user.passwordHash){user.failedAttempts=Number(user.failedAttempts||0)+1;if(user.failedAttempts>=5){user.lockedUntil=new Date(Date.now()+15*60*1000).toISOString();user.failedAttempts=0;}user.updatedAt=now_();repo.replaceAll(rows);audit_({email:email,correlationId:id_()},'users','Authentication','LOGIN_FAILED',user.id,null,{lockedUntil:user.lockedUntil},'Invalid password attempt',1);throw generic;}var stamp=now_();user.failedAttempts=0;user.lockedUntil='';user.lastLoginAt=stamp;user.updatedAt=stamp;repo.replaceAll(rows);var token=secureToken_();var expiresAt=new Date(Date.now()+8*60*60*1000).toISOString();new SheetRepository_('sessions').insertMany([{id:id_(),tokenHash:tokenHash_(token),email:email,createdAt:stamp,expiresAt:expiresAt,lastSeenAt:stamp,revokedAt:''}]);var context={email:email,fullName:user.fullName,role:user.role,userId:user.id,correlationId:id_()};new SheetRepository_('loginEvents').insertMany([{id:id_(),email:email,fullName:user.fullName,signedInAt:stamp,correlationId:context.correlationId}]);audit_(context,'loginEvents','Authentication','LOGIN','',null,{email:email},'Sheet-backed account sign-in',1);return{sessionToken:token,expiresAt:expiresAt,user:getMe_(context)};});}
function authenticate_(sessionToken,correlationId){if(!sessionToken)throw apiError_(401,'Sign in is required.');var hash=tokenHash_(sessionToken);var cache=CacheService.getScriptCache();var cached=cache.get('session:'+hash.slice(0,40));if(cached){var context=JSON.parse(cached);context.correlationId=correlationId||id_();return context;}var sessions=new SheetRepository_('sessions').find(function(row){return row.tokenHash===hash&&!row.revokedAt&&new Date(row.expiresAt).getTime()>Date.now();});if(!sessions.length)throw apiError_(401,'Session is invalid or expired.');var user=new SheetRepository_('users').find(function(row){return row.email===sessions[0].email&&row.status==='ACTIVE';})[0];if(!user)throw apiError_(401,'Account is inactive.');var context={email:user.email,fullName:user.fullName,role:user.role,userId:user.id,correlationId:correlationId||id_()};cache.put('session:'+hash.slice(0,40),JSON.stringify(context),300);return context;}
function logout_(context,sessionToken){return withWriteLock_(function(){var hash=tokenHash_(sessionToken);var repo=new SheetRepository_('sessions');var rows=repo.all();rows.forEach(function(row){if(row.tokenHash===hash&&!row.revokedAt)row.revokedAt=now_();});repo.replaceAll(rows);CacheService.getScriptCache().remove('session:'+hash.slice(0,40));audit_(context,'sessions','Authentication','LOGOUT','',null,{email:context.email},'User logout',1);return{signedOut:true};});}
function requireRole_(context,roles){if(context.role==='OWNER')return;if(!context.role||roles.indexOf(context.role)<0)throw apiError_(403,'You do not have permission for this operation.');}
function getMe_(context){return{email:context.email,fullName:context.fullName,role:context.role,status:'ACTIVE'};}
function requestAccess_(payload){var email=normalizeEmail_(payload.email);var role=String(payload.requestedRole||'VIEWER').toUpperCase();if(!/^\S+@\S+\.\S+$/.test(email))throw apiError_(400,'A valid work email is required.');if(['VIEWER','EDITOR'].indexOf(role)<0)throw apiError_(400,'Requested role must be VIEWER or EDITOR.');if(!String(payload.fullName||'').trim()||!String(payload.reason||'').trim())throw apiError_(400,'Full name and business reason are required.');return withWriteLock_(function(){var repo=new SheetRepository_('accessRequests');var current=repo.all();if(current.some(function(row){return row.email===email&&row.status==='PENDING';}))throw apiError_(409,'A pending request already exists.');var record={id:id_(),email:email,fullName:String(payload.fullName).trim(),requestedRole:role,reason:String(payload.reason).trim(),status:'PENDING',reviewNote:'',reviewedBy:'',reviewedAt:'',createdAt:now_()};repo.insertMany([record]);audit_({email:email,correlationId:id_()},'accessRequests','Authentication','CREATE',record.id,null,record,'User requested platform access',1);return record;});}
function listAccessRequests_(context){requireRole_(context,['ADMIN']);return new SheetRepository_('accessRequests').all().sort(function(a,b){return String(b.createdAt).localeCompare(String(a.createdAt));});}
function reviewAccessRequest_(context,payload){requireRole_(context,['ADMIN']);return withWriteLock_(function(){var repo=new SheetRepository_('accessRequests');var rows=repo.all();var index=rows.findIndex(function(row){return row.id===payload.id&&row.status==='PENDING';});if(index<0)throw apiError_(404,'Pending request not found.');var decision=String(payload.decision||'');var role=String(payload.role||'VIEWER');if(['APPROVED','REJECTED'].indexOf(decision)<0)throw apiError_(400,'Invalid decision.');var before=Object.assign({},rows[index]);rows[index].status=decision;rows[index].reviewNote=String(payload.reviewNote||'');rows[index].reviewedBy=context.email;rows[index].reviewedAt=now_();repo.replaceAll(rows);var activationCode='';if(decision==='APPROVED')activationCode=upsertInvitedUser_(rows[index],role);audit_(context,'accessRequests','Authentication','REVIEW',rows[index].id,before,rows[index],rows[index].reviewNote,1);return{request:rows[index],activationCode:activationCode};});}
function upsertInvitedUser_(request,role){if(['ADMIN','EDITOR','VIEWER'].indexOf(role)<0)throw apiError_(400,'Invalid platform role.');var repo=new SheetRepository_('users');var rows=repo.all();var index=rows.findIndex(function(row){return row.email===request.email;});var stamp=now_();var code=String(Math.floor(10000000+Math.random()*90000000));var record={id:index>=0?rows[index].id:id_(),email:request.email,fullName:request.fullName,role:role,status:'INVITED',passwordHash:'',passwordSalt:'',failedAttempts:0,lockedUntil:'',activationCodeHash:tokenHash_(code),activationExpiresAt:new Date(Date.now()+48*60*60*1000).toISOString(),createdAt:index>=0?rows[index].createdAt:stamp,updatedAt:stamp,lastLoginAt:''};if(index>=0)rows[index]=record;else rows.push(record);repo.replaceAll(rows);return code;}
function activateAccount_(payload){var email=normalizeEmail_(payload.email);var code=String(payload.activationCode||'');var password=String(payload.password||'');validatePassword_(password);return withWriteLock_(function(){var repo=new SheetRepository_('users');var rows=repo.all();var index=rows.findIndex(function(row){return row.email===email&&row.status==='INVITED';});if(index<0||rows[index].activationCodeHash!==tokenHash_(code)||new Date(rows[index].activationExpiresAt).getTime()<Date.now())throw apiError_(400,'Activation code is invalid or expired.');var salt=secureToken_().slice(0,32);rows[index].passwordSalt=salt;rows[index].passwordHash=passwordHash_(password,salt);rows[index].status='ACTIVE';rows[index].activationCodeHash='';rows[index].activationExpiresAt='';rows[index].updatedAt=now_();repo.replaceAll(rows);audit_({email:email,correlationId:id_()},'users','Authentication','ACTIVATE',rows[index].id,null,{email:email,role:rows[index].role},'Account activation',1);return{activated:true};});}
