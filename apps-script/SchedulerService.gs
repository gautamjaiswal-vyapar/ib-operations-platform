function systemContext_(){return{email:'SYSTEM',fullName:'Scheduler',picture:'',role:'ADMIN',userId:'SYSTEM',correlationId:id_()};}
function installPlatformTriggers(){var handlers=['dailyTenurityJob','weeklyPlanningJob','monthlyPlanningJob','dailyBigQueryAgentSyncJob'];ScriptApp.getProjectTriggers().forEach(function(trigger){if(handlers.indexOf(trigger.getHandlerFunction())>=0)ScriptApp.deleteTrigger(trigger);});ScriptApp.newTrigger('dailyTenurityJob').timeBased().everyDays(1).atHour(2).create();ScriptApp.newTrigger('weeklyPlanningJob').timeBased().onWeekDay(ScriptApp.WeekDay.MONDAY).atHour(3).create();ScriptApp.newTrigger('monthlyPlanningJob').timeBased().onMonthDay(1).atHour(4).create();ScriptApp.newTrigger('dailyBigQueryAgentSyncJob').timeBased().everyDays(1).atHour(5).create();return{status:'INSTALLED',handlers:handlers};}
function dailyTenurityJob(){var context=systemContext_();return withWriteLock_(function(){var repo=new SheetRepository_('executives');var rows=repo.all();var changed=0;rows.forEach(function(row){var tenurity=calculateTenurity_(row.doj);if(row.tenurity!==tenurity){row.tenurity=tenurity;row.updatedAt=now_();changed++;}});if(changed){repo.replaceAll(rows);audit_(context,'executives','Tenurity','DAILY_REFRESH','',null,{updated:changed},'Scheduled DOJ-derived tenurity refresh',1);}return{updated:changed};});}
function weeklyPlanningJob(){try{return generatePlanningSnapshot_(systemContext_(),{kind:'weekly'});}catch(error){if(error.status===409)return{status:'ALREADY_FROZEN'};throw error;}}
function monthlyPlanningJob(){try{return generatePlanningSnapshot_(systemContext_(),{kind:'monthly'});}catch(error){if(error.status===409)return{status:'ALREADY_FROZEN'};throw error;}}
function dailyBigQueryAgentSyncJob(){var context=systemContext_();var repo=new SheetRepository_('configuration');var rows=repo.all();var checkpoint=rows.find(function(row){return row.key==='bigQueryAgentsLastSync';});var started=now_();var result=importBigQueryAgents_(context,{limit:5000,updatedAfter:checkpoint?checkpoint.value:'',persist:true});var record={key:'bigQueryAgentsLastSync',value:started,description:'Incremental BigQuery agent synchronization checkpoint',updatedAt:now_(),updatedBy:'SYSTEM'};if(checkpoint)rows[rows.indexOf(checkpoint)]=record;else rows.push(record);repo.replaceAll(rows);audit_(context,'configuration','BigQuery','CHECKPOINT','',checkpoint||null,record,'Daily incremental sync checkpoint',1);return result;}
