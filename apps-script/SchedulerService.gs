function systemContext_(){return{email:'SYSTEM',fullName:'Scheduler',picture:'',role:'ADMIN',userId:'SYSTEM',correlationId:id_()};}
function installPlatformTriggers(){var handlers=['dailyAgentDataRefreshJob','dailyTenurityJob','weeklyPlanningJob','monthlyPlanningJob','dailyBigQueryAgentSyncJob','dailyAgentSheetImportJob'];ScriptApp.getProjectTriggers().forEach(function(trigger){if(handlers.indexOf(trigger.getHandlerFunction())>=0)ScriptApp.deleteTrigger(trigger);});ScriptApp.newTrigger('dailyAgentDataRefreshJob').timeBased().everyDays(1).atHour(2).create();ScriptApp.newTrigger('weeklyPlanningJob').timeBased().onWeekDay(ScriptApp.WeekDay.MONDAY).atHour(3).create();ScriptApp.newTrigger('monthlyPlanningJob').timeBased().onMonthDay(1).atHour(4).create();return{status:'INSTALLED',handlers:['dailyAgentDataRefreshJob','weeklyPlanningJob','monthlyPlanningJob']};}
function dailyAgentDataRefreshJob(){return refreshAgentDataDump_(systemContext_());}
function dailyTenurityJob(){return{status:'DISABLED',reason:'TENURITY_IS_USER_DEFINED'};}
function weeklyPlanningJob(){try{return generatePlanningSnapshot_(systemContext_(),{kind:'weekly'});}catch(error){if(error.status===409)return{status:'ALREADY_FROZEN'};throw error;}}
function monthlyPlanningJob(){try{return generatePlanningSnapshot_(systemContext_(),{kind:'monthly'});}catch(error){if(error.status===409)return{status:'ALREADY_FROZEN'};throw error;}}
