function configurationMap_(){var result={};new SheetRepository_('configuration').all().forEach(function(row){result[row.key]=String(row.value);});return result;}
function normalizeSpreadsheetId_(value){var text=String(value||'').trim();var match=text.match(/\/spreadsheets\/d\/([A-Za-z0-9_-]+)/);return match?match[1]:text;}
function configureRevenueSheet_(context,payload){requireRole_(context,['ADMIN']);var spreadsheetId=normalizeSpreadsheetId_(payload.spreadsheetId);var sheetName=String(payload.sheetName||'').trim();if(!spreadsheetId||!sheetName)throw apiError_(400,'Revenue spreadsheet ID and sheet name are required.');var source=SpreadsheetApp.openById(spreadsheetId).getSheetByName(sheetName);if(!source)throw apiError_(404,'Revenue sheet tab was not found.');return withWriteLock_(function(){var repo=new SheetRepository_('configuration');var rows=repo.all();var values={revenueSpreadsheetId:spreadsheetId,revenueSheetName:sheetName};Object.keys(values).forEach(function(key){var index=rows.findIndex(function(row){return row.key===key;});var record={key:key,value:values[key],description:'External revenue sheet connection',updatedAt:now_(),updatedBy:context.email};if(index>=0)rows[index]=record;else rows.push(record);});repo.replaceAll(rows);audit_(context,'configuration','Revenue','CONFIGURE','',null,{spreadsheetId:spreadsheetId,sheetName:sheetName},'Revenue sheet connection updated',1);return{spreadsheetId:spreadsheetId,sheetName:sheetName};});}
function readRevenueSource_(){var config=configurationMap_();if(!config.revenueSpreadsheetId||!config.revenueSheetName)throw apiError_(400,'Revenue sheet connection is not configured.');var sheet=SpreadsheetApp.openById(config.revenueSpreadsheetId).getSheetByName(config.revenueSheetName);if(!sheet)throw apiError_(404,'Configured revenue sheet tab was not found.');var values=sheet.getDataRange().getValues();if(values.length<2)return[];var aliases={employeeid:'employeeId',periodtype:'periodType',period:'period',revenue:'revenue',login:'login',demo:'demo',license:'license',proplatform:'proPlatform',manualrevenue:'manualRevenue'};var headers=values[0].map(function(value){return aliases[String(value).toLowerCase().replace(/[^a-z0-9]/g,'')]||'';});['employeeId','periodType','period','revenue'].forEach(function(required){if(headers.indexOf(required)<0)throw apiError_(400,'Revenue source is missing header: '+required);});return values.slice(1).filter(function(row){return row.some(function(value){return value!=='';});}).map(function(row,index){var record={};headers.forEach(function(header,column){if(header)record[header]=serializeCell_(row[column]);});record.sourceRow=index+2;record.periodType=String(record.periodType||'MONTH').toUpperCase();record.period=String(record.period).slice(0,10);['revenue','login','demo','license','proPlatform','manualRevenue'].forEach(function(field){record[field]=Number(record[field]||0);if(!isFinite(record[field])||record[field]<0)throw apiError_(400,'Invalid '+field+' at revenue source row '+record.sourceRow);});return record;});}
function previewRevenueSheet_(context){requireRole_(context,['ADMIN']);var rows=readRevenueSource_();return{rows:rows.slice(0,200),count:rows.length,previewLimited:rows.length>200};}
function importRevenueSheet_(context){requireRole_(context,['ADMIN']);var sourceRows=readRevenueSource_();return withWriteLock_(function(){var executives=new SheetRepository_('executives').all();var byEmployee={};executives.forEach(function(row){byEmployee[String(row.employeeId).toUpperCase()]=row;});var missing=[];sourceRows.forEach(function(row){if(!byEmployee[String(row.employeeId).toUpperCase()])missing.push(row.employeeId);});if(missing.length)throw apiError_(400,'Unknown employee IDs in revenue sheet: '+missing.slice(0,10).join(', '));var repo=new SheetRepository_('performance');var rows=repo.all();var byKey={};rows.forEach(function(row,index){byKey[row.periodType+'|'+row.period+'|'+row.executiveId]=index;});var stamp=now_();sourceRows.forEach(function(input){var executive=byEmployee[String(input.employeeId).toUpperCase()];var key=input.periodType+'|'+input.period+'|'+executive.id;var index=byKey[key];var record={id:index>=0?rows[index].id:id_(),periodType:input.periodType,period:input.period,executiveId:executive.id,revenue:input.revenue,login:input.login,demo:input.demo,license:input.license,proPlatform:input.proPlatform,manualRevenue:input.manualRevenue,updatedAt:stamp,updatedBy:context.email};if(index>=0)rows[index]=record;else{byKey[key]=rows.length;rows.push(record);}});repo.replaceAll(rows);new SheetRepository_('sheetImports').insertMany([{id:id_(),type:'REVENUE_SHEET',fileName:configurationMap_().revenueSheetName,status:'SUCCESS',rowCount:sourceRows.length,errorCount:0,createdAt:stamp,createdBy:context.email}]);audit_(context,'performance','Revenue','BULK_UPSERT','',null,{rowCount:sourceRows.length},'External Google Sheet revenue import',1);return{imported:sourceRows.length,total:rows.length};});}
