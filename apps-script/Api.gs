function doGet(){return jsonResponse_({ok:true,data:{name:PLATFORM.NAME,status:'READY',time:now_()}});}
function doPost(e){var request={};try{request=JSON.parse(e&&e.postData?e.postData.contents:'{}');var action=String(request.action||'');if(action==='auth.login')return jsonResponse_({ok:true,data:login_(request.payload||{})});if(action==='auth.activate')return jsonResponse_({ok:true,data:activateAccount_(request.payload||{})});if(action==='access.request')return jsonResponse_({ok:true,data:requestAccess_(request.payload||{})});var context=authenticate_(request.sessionToken,request.correlationId);var data=route_(context,action,request.payload||{},request.sessionToken);return jsonResponse_({ok:true,data:data,correlationId:context.correlationId});}catch(error){var status=error.status||500;console.error(error.stack||error);return jsonResponse_({ok:false,error:{status:status,message:status===500?'Unexpected backend error.':String(error.message)},correlationId:request.correlationId||''});}}
function route_(context,action,payload,sessionToken){if(action==='auth.me')return getMe_(context);if(action==='auth.logout')return logout_(context,sessionToken);if(action==='access.list')return listAccessRequests_(context);if(action==='access.review')return reviewAccessRequest_(context,payload);requireRole_(context,['ADMIN','EDITOR','VIEWER']);if(action==='executives.list')return listExecutives_();if(action==='mappings.list')return listMonthlyMappings_(payload);if(action==='targets.list')return listTargets_();if(action==='sources.list')return listSources_();if(action==='incentives.list')return listIncentives_(payload);if(action==='analytics.dashboard')return dashboard_(payload);requireRole_(context,['ADMIN','EDITOR']);if(action==='mappings.batch')return batchMonthlyMappings_(context,payload);if(action==='targets.batch')return batchTargets_(context,payload);if(action==='planning.generate')return generatePlanningSnapshot_(context,payload);if(action==='incentives.calculate')return calculateIncentives_(context,payload);requireRole_(context,['ADMIN']);if(action==='sources.create')return createSource_(context,payload);if(action==='agents.dump.configure')return configureAgentSheet_(context,payload);if(action==='agents.dump.preview')return previewAgentDump_(context,payload);if(action==='agents.dump.import')return importAgentDump_(context,payload);if(action==='revenue.configure')return configureRevenueSheet_(context,payload);if(action==='revenue.preview')return previewRevenueSheet_(context);if(action==='revenue.import')return importRevenueSheet_(context);throw apiError_(404,'Unknown API action: '+action);}
function apiError_(status,message){var error=new Error(message);error.status=status;return error;}
function jsonResponse_(body){return ContentService.createTextOutput(JSON.stringify(body)).setMimeType(ContentService.MimeType.JSON);}
