function normalizeTenurity_(value){var tenurity=String(value||'').trim().toUpperCase();if(['M0','M1','M1+'].indexOf(tenurity)<0)throw apiError_(400,'Tenurity must be M0, M1, or M1+.');return tenurity;}
function listExecutives_(){return new SheetRepository_('executives').all();}
function listMonthlyMappings_(payload){var month=String(payload.month||now_().slice(0,7));return new SheetRepository_('monthlyMappings').find(function(row){return String(row.month).slice(0,7)===month;});}
function validateAgent_(row){['employeeId','name','email','doj','manager','source','tenurity'].forEach(function(field){if(!String(row[field]||'').trim())throw apiError_(400,'Agent '+field+' is required.');});if(!/^\S+@\S+\.\S+$/.test(String(row.email)))throw apiError_(400,'Invalid agent email: '+row.email);if(isNaN(new Date(row.doj).getTime()))throw apiError_(400,'Invalid DOJ for '+row.employeeId);normalizeTenurity_(row.tenurity);}
function batchMonthlyMappings_(context,payload){var month=String(payload.month||'');if(!/^\d{4}-\d{2}$/.test(month))throw apiError_(400,'Month must be YYYY-MM.');var executiveIds=payload.executiveIds||[];var newExecutives=payload.newExecutives||[];if(!executiveIds.length&&!newExecutives.length)throw apiError_(400,'Select or paste at least one agent.');return withWriteLock_(function(){var executiveRepo=new SheetRepository_('executives');var executives=executiveRepo.all();var employeeIds={};executives.forEach(function(row){employeeIds[String(row.employeeId).toUpperCase()]=true;});var stamp=now_();newExecutives.forEach(function(input){validateAgent_(input);var key=String(input.employeeId).toUpperCase();if(employeeIds[key])throw apiError_(409,'Employee ID already exists: '+input.employeeId);employeeIds[key]=true;executives.push({id:id_(),employeeId:String(input.employeeId),name:String(input.name),email:normalizeEmail_(input.email),doj:String(input.doj).slice(0,10),status:String(input.status||'ACTIVE').toUpperCase(),manager:String(input.manager),source:String(input.source),tenurity:normalizeTenurity_(input.tenurity),active:String(input.status||'ACTIVE').toUpperCase()==='ACTIVE',createdAt:stamp,updatedAt:stamp});});if(newExecutives.length)executiveRepo.replaceAll(executives);var selected={};executiveIds.forEach(function(value){selected[String(value)]=true;});newExecutives.forEach(function(input){var found=executives.find(function(row){return String(row.employeeId)===String(input.employeeId);});selected[found.id]=true;});var mappingRepo=new SheetRepository_('monthlyMappings');var mappings=mappingRepo.all();var existing={};mappings.filter(function(row){return String(row.month).slice(0,7)===month;}).forEach(function(row){existing[row.executiveId]=true;});var additions=executives.filter(function(row){return selected[row.id]&&!existing[row.id];}).map(function(row){return{id:id_(),month:month,executiveId:row.id,employeeId:row.employeeId,name:row.name,email:row.email,manager:row.manager,source:row.source,tenurity:normalizeTenurity_(row.tenurity),status:row.status,frozenAt:stamp,createdAt:stamp,createdBy:context.email};});mappingRepo.insertMany(additions);audit_(context,'monthlyMappings','Mapping','BATCH_CREATE','',null,{month:month,rowCount:additions.length},'Batch monthly agent mapping',1);return additions;});}
function listTargets_(){return new SheetRepository_('targetVersions').all().sort(function(a,b){return String(a.source).localeCompare(String(b.source))||String(a.tenurity).localeCompare(String(b.tenurity))||Number(b.version)-Number(a.version);});}
function validateTarget_(row){if(!String(row.source||'').trim())throw apiError_(400,'Target source is required.');normalizeTenurity_(row.tenurity);if(!/^\d{4}-\d{2}-\d{2}$/.test(String(row.effectiveFrom)))throw apiError_(400,'Effective From must be YYYY-MM-DD.');['revenue','login','demo','license','proPlatform','arpl'].forEach(function(field){if(Number(row[field])<0||!isFinite(Number(row[field])))throw apiError_(400,field+' must be a non-negative number.');});}
function previousDate_(dateText){var value=new Date(dateText+'T00:00:00Z');value.setUTCDate(value.getUTCDate()-1);return value.toISOString().slice(0,10);}
function batchTargets_(context,payload){var inputs=payload.targets||[];if(!inputs.length)throw apiError_(400,'At least one target is required.');return withWriteLock_(function(){var repo=new SheetRepository_('targetVersions');var rows=repo.all();var keys={};var created=[];inputs.forEach(function(input){validateTarget_(input);var tenurity=normalizeTenurity_(input.tenurity);var key=String(input.source).trim().toLowerCase()+'|'+tenurity;if(keys[key])throw apiError_(409,'Duplicate target in batch: '+input.source+' / '+tenurity);keys[key]=true;var versions=rows.filter(function(row){return String(row.source).toLowerCase()===String(input.source).toLowerCase()&&String(row.tenurity).toUpperCase()===tenurity;});var active=versions.find(function(row){return row.status==='ACTIVE';});if(active){if(String(input.effectiveFrom)<=String(active.effectiveFrom))throw apiError_(409,'New effective date must follow the active target for '+input.source+' / '+tenurity);active.status='INACTIVE';active.effectiveTo=previousDate_(String(input.effectiveFrom));}var record={id:id_(),source:String(input.source).trim(),tenurity:tenurity,version:versions.reduce(function(max,row){return Math.max(max,Number(row.version)||0);},0)+1,effectiveFrom:String(input.effectiveFrom),effectiveTo:'',revenue:Number(input.revenue),login:Number(input.login),demo:Number(input.demo),license:Number(input.license),proPlatform:Number(input.proPlatform),arpl:Number(input.arpl),status:'ACTIVE',createdAt:now_(),createdBy:context.email};rows.push(record);created.push(record);});repo.replaceAll(rows);audit_(context,'targetVersions','Target','BATCH_VERSION','',null,{rowCount:created.length,ids:created.map(function(row){return row.id;})},'Effective-dated target batch',created.map(function(row){return row.version;}).join(','));return created;});}
function listSources_(){return new SheetRepository_('sources').all();}
function createSource_(context,payload){var name=String(payload.name||'').trim();var code=String(payload.code||'').trim().toUpperCase();if(!name||!code)throw apiError_(400,'Source name and code are required.');return withWriteLock_(function(){var repo=new SheetRepository_('sources');var rows=repo.all();if(rows.some(function(row){return String(row.name).toLowerCase()===name.toLowerCase()||String(row.code).toUpperCase()===code;}))throw apiError_(409,'Source name or code already exists.');var record={id:id_(),name:name,code:code,description:String(payload.description||''),active:true,createdAt:now_(),createdBy:context.email,updatedAt:now_(),updatedBy:context.email};repo.insertMany([record]);audit_(context,'sources','Configuration','CREATE',record.id,null,record,'New operational source',1);return record;});}
