function createIncentiveRuleVersion_(context,payload){var level=normalizeIncentiveRuleLevel_(payload.level);var effectiveFrom=dateOnly_(payload.effectiveFrom);var effectiveTo=payload.effectiveTo?dateOnly_(payload.effectiveTo):'';var reason=String(payload.reason||'').trim();var slabs=validateRuleSlabs_(payload.slabs,level);if(!effectiveFrom)throw apiError_(400,'Effective from is required.');if(effectiveTo&&effectiveTo<effectiveFrom)throw apiError_(400,'Effective till cannot be before Effective from.');if(reason.length<5)throw apiError_(400,'Enter a reason with at least 5 characters.');return withWriteLock_(function(){var repo=new SheetRepository_('bonusRules');var rows=repo.all();var sameLevel=rows.filter(function(row){return ruleLevel_(row)===level;});var latestFrom=sameLevel.reduce(function(latest,row){return String(row.effectiveFrom)>latest?String(row.effectiveFrom):latest;},'');if(latestFrom&&effectiveFrom<=latestFrom)throw apiError_(409,'Effective from must be later than the latest '+level.replace(/_/g,' ')+' rule version ('+latestFrom+').');var version=sameLevel.reduce(function(max,row){return Math.max(max,Number(row.version)||1);},0)+1;var previousEnd=dayBeforeRuleDate_(effectiveFrom);var stamp=now_();var today=stamp.slice(0,10);rows.forEach(function(row){if(ruleLevel_(row)!==level)return;if(!row.effectiveTo||String(row.effectiveTo)>=effectiveFrom){row.effectiveTo=previousEnd;row.active=previousEnd>=today;row.status=previousEnd>=today?'ACTIVE':'ARCHIVED';}});var newStatus=effectiveFrom>today?'SCHEDULED':effectiveTo&&effectiveTo<today?'ARCHIVED':'ACTIVE';slabs.forEach(function(slab,index){rows.push({id:id_(),name:ruleDisplayName_(level,slab.threshold),minAchievement:slab.threshold,maxAchievement:index<slabs.length-1?slabs[index+1].threshold:'',incentiveRate:slab.amount,bonusMultiplier:1,managerRule:level==='TEAM_LEAD',effectiveFrom:effectiveFrom,effectiveTo:effectiveTo,active:newStatus==='ACTIVE',level:level,version:version,status:newStatus,reason:reason,create