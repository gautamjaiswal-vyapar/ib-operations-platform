var IPT_AGENT_SNAPSHOT_DEFAULTS_=Object.freeze({spreadsheetId:'1_FnDwWgxEk8c-G8nb-BiTSrqXKGaDJqxGBecgbr6ml4',sourceSheet:'AgentData',historySheet:'AgentPerformanceHistory'});
var IPT_AGENT_HISTORY_HEADERS_=Object.freeze(['capturedAt','periodType','period','agentEmail','agentId','teamLead','designation','cluster','iptTeam','leads','logins','demos','conversions']);
var IPT_AGENT_PERIOD_TYPES_=Object.freeze(['DAY','WEEK','MONTH']);

function configureIptAgentSnapshotSource(spreadsheetId,sourceSheetName,historySheetName){
  if(!spreadsheetId)throw new Error('IPT agent spreadsheet ID is required.');
  PropertiesService.getScriptProperties().setProperties({IPT_AGENT_SPREADSHEET_ID:String(spreadsheetId).trim(),IPT_AGENT_SOURCE_SHEET:String(sourceSheetName||IPT_AGENT_SNAPSHOT_DEFAULTS_.sourceSheet).trim(),IPT_AGENT_HISTORY_SHEET:String(historySheetName||IPT_AGENT_SNAPSHOT_DEFAULTS_.historySheet).trim()});
  return setupIptAgentPerformanceHistory();
}
function iptAgentSnapshotConfig_(){var properties=PropertiesService.getScriptProperties();return{spreadsheetId:properties.getProperty('IPT_AGENT_SPREADSHEET_ID')||IPT_AGENT_SNAPSHOT_DEFAULTS_.spreadsheetId,sourceSheet:properties.getProperty('IPT_AGENT_SOURCE_SHEET')||IPT_AGENT_SNAPSHOT_DEFAULTS_.sourceSheet,historySheet:properties.getProperty('IPT_AGENT_HISTORY_SHEET')||IPT_AGENT_SNAPSHOT_DEFAULTS_.historySheet};}
function setupIptAgentPerformanceHistory(){var config=iptAgentSnapshotConfig_();var spreadsheet=SpreadsheetApp.openById(config.spreadsheetId);var source=spreadsheet.getSheetByName(config.sourceSheet);if(!source)throw new Error('Missing IPT agent source sheet: '+config.sourceSheet);var history=spreadsheet.getSheetByName(config.historySheet)||spreadsheet.insertSheet(config.historySheet);ensureIptAgentHistoryHeaders_(history);return{status:'READY',spreadsheetId:spreadsheet.getId(),sourceSheet:source.getName(),historySheet:history.getName()};}

function captureIptAgentPerformanceSnapshots(){return syncIptAgentPerformanceHistory();}
function syncIptAgentPerformanceHistory(){return withWriteLock_(function(){var config=iptAgentSnapshotConfig_();var spreadsheet=SpreadsheetApp.openById(config.spreadsheetId);var source=spreadsheet.getSheetByName(config.sourceSheet);if(!source)throw new Error('Missing IPT agent source sheet: '+config.sourceSheet);var history=spreadsheet.getSheetByName(config.historySheet)||spreadsheet.insertSheet(config.historySheet);ensureIptAgentHistoryHeaders_(history);var records=readIptAgentPeriodHistory_(source);if(!records.length)return{status:'NO_DATA',records:0,updated:0,inserted:0};var result=upsertIptAgentHistory_(history,records);var periods={DAY:{},WEEK:{},MONTH:{}};records.forEach(function(record){periods[record.periodType][record.period]=true;});return{status:'SYNCED',capturedAt:records[0].capturedAt,records:records.length,agents:Object.keys(records.reduce(function(all,row){all[row.agentId||row.agentEmail]=true;return all;},{})).length,periods:{DAY:Object.keys(periods.DAY).length,WEEK:Object.keys(periods.WEEK).length,MONTH:Object.keys(periods.MONTH).length},updated:result.updated,inserted:result.inserted};});}
function dailyIptAgentPerformanceSnapshotJob(){return syncIptAgentPerformanceHistory();}

function listIptAgentPerformanceHistory_(payload){var config=iptAgentSnapshotConfig_();var spreadsheet=SpreadsheetApp.openById(config.spreadsheetId);var source=spreadsheet.getSheetByName(config.sourceSheet);if(!source)throw apiError_(404,'Missing IPT agent source sheet: '+config.sourceSheet);var rows=readIptAgentPeriodHistory_(source);var type=String(payload&&payload.periodType||'').toUpperCase();var from=dateOnly_(payload&&payload.from);var to=dateOnly_(payload&&payload.to);rows=rows.filter(function(row){return(!type||row.periodType===type)&&(!from||row.period>=from)&&(!to||row.period<=to);});var periods={DAY:{},WEEK:{},MONTH:{}};rows.forEach(function(row){if(periods[row.periodType])periods[row.periodType][row.period]=true;});return{rows:rows,periods:{DAY:Object.keys(periods.DAY).sort().reverse(),WEEK:Object.keys(periods.WEEK).sort().reverse(),MONTH:Object.keys(periods.MONTH).sort().reverse()},sourceSheet:source.getName(),generatedAt:now_()};}

function ensureIptAgentHistoryHeaders_(sheet){var headers=IPT_AGENT_HISTORY_HEADERS_;if(sheet.getMaxColumns()<headers.length)sheet.insertColumnsAfter(sheet.getMaxColumns(),headers.length-sheet.getMaxColumns());var current=sheet.getRange(1,1,1,headers.length).getValues()[0];if(current.join('|')!==headers.join('|')){var populated=current.filter(String).length;var appendOnly=populated<headers.length&&current.slice(0,populated).join('|')===headers.slice(0,populated).join('|');if(sheet.getLastRow()>1&&current.some(String)&&!appendOnly)throw new Error('Header mismatch on '+sheet.getName()+'. Preserve its data and align the history headers first.');sheet.getRange(1,1,1,headers.length).setValues([headers]);}sheet.setFrozenRows(1);sheet.getRange(1,1,1,headers.length).setFontWeight('bold').setBackground('#172033').setFontColor('#ffffff');sheet.getRange('B:C').setNumberFormat('@');}

function readIptAgentPeriodHistory_(sheet){
  var lastRow=sheet.getLastRow();var lastColumn=sheet.getLastColumn();if(lastRow<2||lastColumn<1)return[];var values=sheet.getRange(1,1,lastRow,lastColumn).getValues();var headers={};values[0].forEach(function(value,index){headers[String(value||'').trim().toLowerCase()]=index;});
  var required=['month_agent_email','month_agent_id','month_team_lead','month_agent_designation','month_cluster_name','month_ipt_team','period_type','period_start','leads_created','logins','demos','conversions'];required.forEach(function(header){if(!Object.prototype.hasOwnProperty.call(headers,header))throw new Error('Missing required AgentData history column: '+header+'. Refresh the updated Connected Sheets query first.');});
  var capturedAt=now_();var byKey={};values.slice(1).forEach(function(row){var periodType=String(row[headers.period_type]||'').trim().toUpperCase();if(IPT_AGENT_PERIOD_TYPES_.indexOf(periodType)<0)return;var period=dateOnly_(row[headers.period_start]);var agentId=String(row[headers.month_agent_id]||'').trim();var agentEmail=normalizeEmail_(row[headers.month_agent_email]);var identity=agentId||agentEmail;if(!period||!identity)return;var key=periodType+'|'+period+'|'+identity.toLowerCase();var record=byKey[key];if(!record)record=byKey[key]={capturedAt:capturedAt,periodType:periodType,period:period,agentEmail:agentEmail,agentId:agentId,teamLead:'',designation:'',cluster:'',iptTeam:'',leads:0,logins:0,demos:0,conversions:0};record.agentEmail=agentEmail||record.agentEmail;record.agentId=agentId||record.agentId;record.teamLead=String(row[headers.month_team_lead]||record.teamLead||'').trim();record.designation=String(row[headers.month_agent_designation]||record.designation||'').trim();record.cluster=String(row[headers.month_cluster_name]||record.cluster||'').trim();record.iptTeam=String(row[headers.month_ipt_team]||record.iptTeam||'').trim();record.leads+=iptMetricNumber_(row[headers.leads_created]);record.logins+=iptMetricNumber_(row[headers.logins]);record.demos+=iptMetricNumber_(row[headers.demos]);record.conversions+=iptMetricNumber_(row[headers.conversions]);});return Object.keys(byKey).map(function(key){return byKey[key];});
}
function iptMetricNumber_(value){var number=Number(String(value===null||value===undefined?'':value).replace(/,/g,'').trim()||0);return isFinite(number)?number:0;}
function iptAgentHistoryKey_(record){return String(record.periodType)+'|'+dateOnly_(record.period)+'|'+String(record.agentId||record.agentEmail).toLowerCase();}
function iptAgentHistoryRow_(record){return IPT_AGENT_HISTORY_HEADERS_.map(function(header){return record[header]===undefined||record[header]===null?'':record[header];});}

function upsertIptAgentHistory_(sheet,records){var lastRow=sheet.getLastRow();var rowByKey={};if(lastRow>1)sheet.getRange(2,2,lastRow-1,4).getValues().forEach(function(row,index){var identity=String(row[3]||row[2]||'').toLowerCase();if(identity)rowByKey[String(row[0]).toUpperCase()+'|'+dateOnly_(row[1])+'|'+identity]=index+2;});var updates=[];var inserts=[];records.forEach(function(record){var rowNumber=rowByKey[iptAgentHistoryKey_(record)];if(rowNumber)updates.push({rowNumber:rowNumber,values:iptAgentHistoryRow_(record)});else inserts.push(iptAgentHistoryRow_(record));});updates.sort(function(a,b){return a.rowNumber-b.rowNumber;});var group=[];var flush=function(){if(!group.length)return;sheet.getRange(group[0].rowNumber,1,group.length,IPT_AGENT_HISTORY_HEADERS_.length).setValues(group.map(function(item){return item.values;}));group=[];};updates.forEach(function(update){if(group.length&&update.rowNumber!==group[group.length-1].rowNumber+1)flush();group.push(update);});flush();if(inserts.length)sheet.getRange(sheet.getLastRow()+1,1,inserts.length,IPT_AGENT_HISTORY_HEADERS_.length).setValues(inserts);return{updated:updates.length,inserted:inserts.length};}
