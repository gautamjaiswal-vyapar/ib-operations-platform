{
  "name": "ib-operations-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "build": "npm run build --workspace=@ib/api && npm run build --workspace=@ib/web",
    "dev": "concurrently \"npm run start:dev --workspace=@ib/api\" \"npm run dev --workspace=@ib/web\"",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace=@ib/api",
    "test:e2e": "npm run test:e2e --workspace=@ib/api",
    "seed": "npm run seed --workspace=@ib/api",
    "migrate": "npm run migrate --workspace=@ib/api"
  },
  "devDependencies": { "concurrently": "^9.1.2" },
  "engines": { "node": ">=20.11", "npm": ">=10" }
}
