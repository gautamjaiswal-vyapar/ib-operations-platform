{
  "name": "ib-operations-platform",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@ib/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "node scripts/verify-apps-script.mjs && npm run lint",
    "start": "npm run start --workspace=@ib/web"
  },
  "engines": {
    "node": ">=20.11",
    "npm": ">=10"
  },
  "allowScripts": {
    "sharp": true
  }
}
